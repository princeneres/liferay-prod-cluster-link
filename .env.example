# Copy to .env and replace every value. Never commit .env.
POSTGRES_USER=liferay_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=liferay_db

# Must match the keystore created by scripts/generate-cluster-keystore.sh
CLUSTER_KEYSTORE_PASSWORD=change-me
# Shared secret validated by the AUTH protocol when a node joins
CLUSTER_AUTH_VALUE=change-me

# JGroups stack used by both channels
JGROUPS_STACK=/opt/liferay/unicast/tcp.xml

LIFERAY_HEAP=6g
ES_HEAP=4g
NODE1_PORT=8080
NODE2_PORT=9080
NGINX_PORT=80
